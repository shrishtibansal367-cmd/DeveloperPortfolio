#!/bin/bash
# Author: Your Name (Roll No: XXXXXX)
# Description: Creates a timestamped .tar.gz backup of a folder

# 1. Check an argument was given
if [ $# -eq 0 ]; then
    echo "Usage: ./backup.sh <folder>"
    exit 1
fi

SOURCE="$1"

# 2. Check the folder exists
if [ ! -d "$SOURCE" ]; then
    echo "Error: Folder '$SOURCE' does not exist."
    exit 1
fi

# 3. Prepare backup location and filename
BACKUP_DIR="$HOME/DeveloperPortfolio_Backups"
mkdir -p "$BACKUP_DIR"
TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
BACKUP_FILE="$BACKUP_DIR/backup_${TIMESTAMP}.tar.gz"
LOG_FILE="$BACKUP_DIR/backup.log"

# 4. Create the compressed archive
if tar -czf "$BACKUP_FILE" -C "$(dirname "$SOURCE")" "$(basename "$SOURCE")"; then
    SIZE=$(du -h "$BACKUP_FILE" | cut -f1)
    echo "Backup successful!"
    echo "File: $BACKUP_FILE"
    echo "Size: $SIZE"
    echo "$TIMESTAMP | SUCCESS | $SOURCE -> $BACKUP_FILE ($SIZE)" >> "$LOG_FILE"
else
    echo "Error: Backup failed."
    echo "$TIMESTAMP | FAILED  | $SOURCE" >> "$LOG_FILE"
    exit 1
fi
